#!/bin/sh
# Runs Hunch: `hunch --help`, `hunch build`, `hunch check`, ...
# Uses the src/ folder of the repository you are in, so your own edits apply.
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}" exec python -c 'from hunch.build import cli; cli(prog_name="hunch")' "$@"
